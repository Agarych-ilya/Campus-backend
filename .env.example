DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_db
PORT=8000
# Optional: bot must be able to query the Telegram group/channel
TELEGRAM_BOT_TOKEN=
# Optional: VK API service/access token for members_count
VK_ACCESS_TOKEN=
# Community moderation uses existing backend account IDs (never an email flag).
# To enable, first register an account, get its users.id from MySQL,
# then configure BOTH of the following. Example: COMMUNITY_ADMIN_USER_IDS=7
COMMUNITY_ADMIN_USER_IDS=
# Cryptographically random secret, at least 32 characters.
# Required if COMMUNITY_ADMIN_USER_IDS is set.
SESSION_SECRET=
# Set true only when API is behind HTTPS (USB debug uses false).
COOKIE_SECURE=false
# Optional comma-separated trusted website origins; native app does not need CORS.
CORS_ALLOWED_ORIGINS=
