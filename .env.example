DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_db
PORT=8000
# Optional: bot must be able to query the Telegram group/channel
TELEGRAM_BOT_TOKEN=
# Optional: VK API service/access token for members_count
VK_ACCESS_TOKEN=
# Moderators are existing backend accounts, not BARS profile names.
# 1. Register your unique username with POST /auth/register while the
#    following variable is unset (for example OgarkovIA).
# 2. Then add the registered name(s) here. Login needs username + password.
COMMUNITY_ADMIN_USERNAMES=
# Optional: BARS single-sign-on moderation by verified record book number.
# Read the number from your CampusApp profile / BARS page (№ЗК).
# Only the backend compares it with the real authenticated BARS page.
# Multiple allowed record books separated by commas; NO BARS passwords.
COMMUNITY_ADMIN_BARS_RECORD_BOOKS=
# Legacy optional allowlist by numeric users.id; not required with usernames.
COMMUNITY_ADMIN_USER_IDS=
# Cryptographically random secret, at least 32 characters.
# Required whenever either admin allowlist is configured.
SESSION_SECRET=
# Set true only when API is behind HTTPS (USB debug uses false).
COOKIE_SECURE=false
# Optional comma-separated trusted website origins; native app does not need CORS.
CORS_ALLOWED_ORIGINS=
